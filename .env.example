APP_ENV=development
API_HOST=0.0.0.0
API_PORT=18000
FRONTEND_PORT=15173

# Keep local development services bound to localhost by default.
POSTGRES_BIND_HOST=127.0.0.1
REDIS_BIND_HOST=127.0.0.1
MINIO_BIND_HOST=127.0.0.1
API_BIND_HOST=127.0.0.1
FRONTEND_BIND_HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXY_HOSTS=127.0.0.1,::1
GENERATION_CREATE_RATE_LIMIT_WINDOW_SECONDS=300
GENERATION_CREATE_RATE_LIMIT_MAX_REQUESTS=3

POSTGRES_DB=kig_preview
POSTGRES_USER=kig
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql+asyncpg://kig:change-me-postgres-password@postgres:5432/kig_preview
REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=kig_minio
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:19000
S3_ACCESS_KEY_ID=kig_minio
S3_SECRET_ACCESS_KEY=change-me-minio-password
S3_BUCKET=kig-preview

JWT_SECRET=change-me-generate-a-long-random-secret
MOCK_SMS_CODE=000000
ADMIN_AUDIT_PASSWORD=change-me-admin-audit-password

GENERATION_PROVIDER=codex
# Optional overrides. Empty values are derived from GENERATION_PROVIDER.
# LLM_PROVIDER: openai_compatible | codex | claude_code | fixture (reference safety check + detail analysis)
# IMAGE_PROVIDER: codex | codex_bridge | siliconflow | ark | fixture (front view, turnaround, local revision)
LLM_PROVIDER=
IMAGE_PROVIDER=
# Backends picked on the /settings page are saved here and override the values in this file.
RUNTIME_SETTINGS_PATH=runtime/settings-overrides.json
ALLOW_FIXTURE_GENERATION=false
MOCK_OUTPUT_DIR=runtime/mock-outputs
CODEX_PATH=codex
CODEX_CONFIG_DIR=./runtime/codex-home
CODEX_BRIDGE_URL=http://host.docker.internal:18100
CODEX_BRIDGE_TOKEN=change-me-local-bridge-token
CODEX_BRIDGE_TIMEOUT_SECONDS=1800
CODEX_WORKSPACE_DIR=runtime/codex
CODEX_OUTPUT_DIR=runtime/generated
REFERENCE_UPLOAD_DIR=runtime/references
CODEX_PRODUCT_REFERENCE_PATH=ref/product-reference.png
GENERATED_PUBLIC_PREFIX=/api/generated

CLAUDE_CODE_PATH=claude
# Logged-in Claude Code config directory, mounted to /root/.claude in the api and worker containers.
CLAUDE_CODE_CONFIG_DIR=./runtime/claude-home
CLAUDE_CODE_MODEL=
CLAUDE_CODE_WORKSPACE_DIR=runtime/claude-code
CLAUDE_CODE_TIMEOUT_SECONDS=240

# Used when IMAGE_PROVIDER=siliconflow. 0 / empty values fall back to the API defaults.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_IMAGE_MODEL=Qwen/Qwen-Image-Edit-2509
SILICONFLOW_NUM_INFERENCE_STEPS=0
SILICONFLOW_CFG=0
SILICONFLOW_TIMEOUT_SECONDS=300
SILICONFLOW_MAX_RETRIES=3
SILICONFLOW_MAX_INPUT_SIDE=2048
SILICONFLOW_WORKSPACE_DIR=runtime/siliconflow

# Used when IMAGE_PROVIDER=ark (Volcengine Ark Agent Plan, Seedream). Needs the Agent Plan dedicated API key.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro
ARK_FRONT_SIZE=2K
ARK_TURNAROUND_SIZE=1920x1280
ARK_LOCAL_EDIT_SIZE=1K
ARK_MAX_REFERENCE_IMAGES=4
ARK_TIMEOUT_SECONDS=300
ARK_MAX_RETRIES=2
ARK_MAX_INPUT_SIDE=2048
ARK_WORKSPACE_DIR=runtime/ark

# Conversational agent (the chat UI). The orchestrator LLM decides which tools to call.
# AGENT_LLM_PROVIDER: openai_compatible | claude_code
AGENT_LLM_PROVIDER=openai_compatible
# Any OpenAI-compatible /chat/completions endpoint with tool calling. Defaults to Volcengine Ark Agent Plan;
# when the base URL equals ARK_BASE_URL and AGENT_LLM_API_KEY is empty, ARK_API_KEY is reused.
AGENT_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=doubao-seed-2-0-pro
# Extra JSON merged into every chat request (e.g. turn off reasoning for faster replies).
AGENT_LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
AGENT_LLM_TIMEOUT_SECONDS=120
# Model for AGENT_LLM_PROVIDER=claude_code (empty = Claude Code default). Slower: one CLI call per step.
AGENT_CLAUDE_CODE_MODEL=
# Used when LLM_PROVIDER=openai_compatible. The model must accept images (image_url content parts).
# Empty values reuse AGENT_LLM_BASE_URL / AGENT_LLM_API_KEY / AGENT_LLM_MODEL.
ANALYSIS_LLM_BASE_URL=
ANALYSIS_LLM_API_KEY=
ANALYSIS_LLM_MODEL=
ANALYSIS_LLM_MAX_IMAGE_SIDE=1536
AGENT_MAX_STEPS_PER_TURN=12
# Hard cap on image generations the agent may start per user message.
AGENT_MAX_GENERATIONS_PER_TURN=3
AGENT_DIR=runtime/agent
# Unwatermarked copies of generated images (not publicly served), used as inputs for revisions/turnarounds.
CLEAN_OUTPUT_DIR=runtime/clean-outputs

WATERMARK_TEXT=V.S.K AI generated
WATERMARK_DOMAIN_TEXT=V.S.K

MAX_PROVIDER_CONCURRENCY=8
NORMAL_QUOTA_WINDOW_HOURS=5
NORMAL_BASE_QUOTA=2
